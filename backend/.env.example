# TiDB Cloud connection (isi setelah bikin cluster di TiDB Cloud)
TIDB_HOST=gateway01.xx-region.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_username.root
TIDB_PASSWORD=your_password
TIDB_DATABASE=digital_gift

# CORS - domain frontend yang boleh akses backend
FRONTEND_ORIGIN=http://localhost:5173
